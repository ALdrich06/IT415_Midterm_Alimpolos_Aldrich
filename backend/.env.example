# Express backend configuration
# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:3000

# Supabase project settings (Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service role key - SERVER SIDE ONLY. Never expose this to the frontend
# or commit it to version control. Bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct Postgres connection string - used ONLY by scripts/run-migrations.js
# (Supabase dashboard -> Settings -> Database -> Connection string -> URI)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
